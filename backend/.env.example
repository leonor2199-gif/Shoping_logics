# Application
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/product_ordering_platform

# Authentication (replace with a long, random value)
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d

# Browser clients allowed to call this API (comma-separated)
CORS_ORIGIN=http://localhost:5173

# Production transport security (enable only behind a correctly configured HTTPS proxy)
TRUST_PROXY=1
ENFORCE_HTTPS=false

# Initial administrator bootstrap — set these only while running `npm run seed:admin`
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
